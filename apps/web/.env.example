# Aussie EcoLens web frontend env template
# Do not commit real Cognito IDs, JWTs, passwords, or service account JSON.
# Vite only exposes VITE_-prefixed variables to client code.

VITE_COGNITO_REGION=<paste-from-aws-console>
VITE_COGNITO_USER_POOL_ID=<paste-from-aws-console>
VITE_COGNITO_APP_CLIENT_ID=<paste-from-aws-console-spa-client>

# Base URL of the auth-proof API service (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080
