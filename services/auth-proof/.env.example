# Placeholder values only. Copy to .env locally and fill from AWS/GCP dashboards.
# Secrets, passwords, JWTs, and service account JSON must never be committed.
# Do not commit real Cognito client IDs, tokens, JWTs, or service account JSON.

COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_example
COGNITO_APP_CLIENT_ID=exampleclientid
COGNITO_TOKEN_USE=access

PORT=8080
GCP_PROJECT_ID=fit5225-aussie-ecolens
GCP_REGION=australia-southeast1

# Comma-separated list of allowed browser origins for protected API calls.
# Defaults to http://localhost:5173 when unset. Add the deployed frontend origin
# (e.g. https://your-frontend.example) once Phase 6/7 deploys the UI.
CORS_ALLOWED_ORIGINS=http://localhost:5173
