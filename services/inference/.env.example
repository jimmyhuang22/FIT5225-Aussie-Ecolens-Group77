# Aussie EcoLens inference service env template.
# Do not commit real model paths, GCS URIs you treat as sensitive, or any secret values.

# --- Required ---
# Local dev: point at AussieEcoLense/ assets at the repo root.
# Cloud Run: point at gs:// URIs in the model bucket.
MODEL_PATH_MD=./AussieEcoLense/mdv5a.pt
MODEL_PATH_SPECIES=./AussieEcoLense/model.pt
LABELS_PATH=./AussieEcoLense/labels.txt

# Model version strings echoed in every /inference response so Phase 4 can persist
# them on media_items.modelVersion. Use ISO date or semantic versioning.
MODEL_VERSION_MD=mdv5a-v1
MODEL_VERSION_SPECIES=speciesnet-au-v1

# --- Optional (defaults shown) ---
# MegaDetector confidence threshold for accepting a bounding box (matches AussieEcoLense/config.yaml).
MD_CONF_THRESHOLD=0.05
# Pixel size of the square crop fed into SpeciesNet (matches AussieEcoLense/config.yaml).
MD_SNIP_SIZE=600
# How many top SpeciesNet predictions to return per detection.
SPECIES_TOP_K=3
# Auth mode: 'iam' (Cloud Run IAM), 'api_key' (public Cloud Run + shared header),
# or 'open' (local dev only).
# 'open' DISABLES all authentication — never set this on a deployed service.
INFERENCE_AUTH_MODE=open
# Required when INFERENCE_AUTH_MODE=api_key. AWS processor sends this value in
# X-Inference-Api-Key. Do not commit a real value.
INFERENCE_API_KEY=change-me
# HTTP port. Cloud Run injects PORT=8080; uvicorn binds to this value.
PORT=8080
# Python logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
